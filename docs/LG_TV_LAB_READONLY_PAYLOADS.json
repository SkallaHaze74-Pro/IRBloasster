    {"id": "com.webos.app.recordings", "title": "Recordings"},
    {"id": "com.webos.app.notificationcenter", "title": "Notifications"},
    {"id": "com.webos.app.connectionwizard", "title": "Universal Control Settings"},
    {"id": "com.webos.app.roomconnect", "title": "Room to Room Share"},
    {"id": "com.webos.app.appcasting", "title": "App Casting"},
    {"id": "com.webos.app.camera", "title": "Camera"},
    {"id": "com.webos.app.homeconnect", "title": "Home Dashboard"},
    {"id": "com.webos.app.igallery", "title": "Art Gallery"}
