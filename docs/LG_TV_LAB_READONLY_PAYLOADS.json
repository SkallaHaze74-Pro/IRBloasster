  "capabilityScan": {
    "uri": "ssap://config/getConfigs",
    "payload": {
      "configNames": [
        "tv.model.modelname",
        "tv.hw.SoCChipType",
        "tv.hw.dramSize",
        "tv.hw.emmcSize",
        "tv.hw.eepromSize",
        "tv.hw.displayType",
        "tv.hw.panelResolution",
        "tv.hw.SoCOutputFrameRate",
        "tv.model.cellType",
        "tv.model.moduleInchType",
        "tv.model.motionProMode",
        "tv.model.motionRemoconType",
        "tv.model.soundModeType",
        "tv.model.supportDolbyVisionHDR",
        "tv.model.supportHDR",
        "tv.model.supportVRR",
        "tv.model.supportIsf",
        "tv.model.supportWiSA",
        "tv.model.supportOledTconOrbit",
        "tv.model.supportLocalDimming",
        "tv.model.supportHeadPhone",
        "tv.model.supportAudioLineOut",
        "tv.hw.supportOptic",
        "tv.hw.supportSatellite",
        "tv.hw.supportT2Tuner",
        "tv.hw.supportTripleTuner",
        "system.supportBluetoothFeatures",
        "system.supportVoiceRecognition",
        "tv.nyx.firmwareVersion",
        "tv.nyx.platformVersion",
        "tv.nyx.bootloaderVersion",
        "tv.nyx.tvBroadcastSystem",
        "tv.rmm.dvrReady",
        "tv.conti.supportRemoteService",
        "tv.conti.supportSignalTest",
        "tv.conti.supportUsedTime"
      ]
    }
  },
  "settingsReads": [
    {
      "name": "network",
      "uri": "ssap://settings/getSystemSettings",
      "payload": {
        "category": "network",
        "keys": ["deviceName", "wolwowlOnOff", "bleAdvertisingOnOff"]
      }
    },
    {
      "name": "picture",
      "uri": "ssap://settings/getSystemSettings",
      "payload": {
        "category": "picture",
        "keys": ["brightness", "backlight", "contrast", "color", "energySaving"]
      }
    },
    {
      "name": "sound",
      "uri": "ssap://settings/getSystemSettings",
      "payload": {
        "category": "sound",
        "keys": ["avSync", "avSyncSpdif", "avSyncBypassInput", "eArcSupport", "soundOutput", "soundOutputDigital", "soundMode", "tvSetupConfiguration"]
      }
    },
    {
      "name": "cec-universal-remote",
      "uri": "ssap://settings/getSystemSettings",
      "payload": {
        "category": "other",
        "keys": ["simplinkEnable", "ueiEnable"]
      }
    },
    {
      "name": "option",
      "uri": "ssap://settings/getSystemSettings",
      "payload": {
        "category": "option",
        "keys": ["audioGuidance", "country", "zipcode", "livePlus", "firstTvSignalStatus", "localeCountryGroup", "countryBroadcastSystem"]
      }
    },
    {
      "name": "general",
      "uri": "ssap://settings/getSystemSettings",
      "payload": {
        "category": "general",
        "keys": ["alwaysOn", "tvOnScreen", "tvInstallMethod", "powerOffBySCA3SystemChanged", "SCA3SystemCountry"]
      }
    }
  ],
  "safeHiddenAppLaunches": [
